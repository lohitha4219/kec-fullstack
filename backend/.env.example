# Django
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Database — leave DB_ENGINE unset (or anything other than "mysql") to use SQLite.
# Set DB_ENGINE=mysql and fill in the vars below to use MySQL instead.
DB_ENGINE=sqlite
DB_NAME=smart_campus
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS — the origins allowed to call this API (your React/Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
